# Copy to .env (repo root) and fill in. .env is git-ignored; never commit real keys.
# The backend loads this file with override=True, so it beats any OPENAI_* in your shell.

# Akamai workshop inference (OpenAI-compatible chat completions + tool calls + JSON schema)
OPENAI_BASE_URL=https://ws.akamai-workshops.com/v1
OPENAI_API_KEY=hk_your-team-key-here
CHAT_MODEL=hackathon-chat
EMBEDDING_MODEL=hackathon-embedding

# Object storage (optional, not used yet)
OBJ_ENDPOINT=
OBJ_BUCKET=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=

# Empty = SQLite at backend/closure_call.db. Postgres: postgresql://user:pass@host:5432/closurecall
DATABASE_URL=

# --- Optional app settings -------------------------------------------------------
# api.weather.gov requires a User-Agent identifying your app and a contact.
NWS_USER_AGENT=ClosureCall/0.1 (hackathon demo; you@example.com)
# Agent limits. Team quota is 60 req/min (all endpoints, shared); we cap ourselves lower.
LLM_REQUESTS_PER_MINUTE=45
LLM_CALLS_PER_EVALUATION=12
AGENT_TIMEOUT_SECONDS=45
LOCAL_AGENT_TIMEOUT_SECONDS=45
# Push via ntfy.sh (each person's own topic; NTFY_TOPIC is the fallback) / email via Resend.
# Unset: printed to the console, channel result ok=false.
NTFY_TOPIC=
RESEND_API_KEY=
RESEND_FROM=Closure Call <onboarding@resend.dev>
NOTIFY_EMAIL_OVERRIDE=
SNAPSHOT_DIR=./snapshots
# Production (compose.prod.yml): domain for automatic HTTPS. Empty = plain HTTP on :80.
SITE_DOMAIN=
# Links in messages (ack). Production: the public URL, e.g. http://172.238.168.201
PUBLIC_BASE_URL=
# 1 = ack reminder/escalation timers 1/2/3 min and /api/demo/simulate enabled
DEMO_MODE=0
# Public demo phone topics use this suffix; not an API credential.
DEMO_TOPIC_SUFFIX=
